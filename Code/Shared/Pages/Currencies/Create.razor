@page "/currencies/create"
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage 
    Entity="currency" 
    EntityTitle="Currency" 
    BasePath="/currencies" 
    OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(Currency))] private Currency currency { get; set; } = default!;
    protected override void OnInitialized() => currency ??= new();
    private async Task add()
    {
		await repo.CreateAsync(currency);
        NavigationManager.NavigateTo("/currencies");
    }
}

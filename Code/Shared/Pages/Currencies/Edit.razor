@page "/currencies/edit"
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyEditPage 
    PageTitleText="Edit Currency" 
    EntityTitle="@currency.Name" 
    Entity="currency" 
    BasePath="/currencies" 
    EntityId="@Id"
    OnValidSubmit="update" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(Currency))] private Currency currency { get; set; }
    protected override async Task OnInitializedAsync()
    {
        currency ??= await repo.GetAsync(Id);
		if (currency is null) NavigationManager.NotFound();
    }
    private async Task update()
    {
		await repo.UpdateAsync(currency!);
        NavigationManager.NavigateTo("/currencies");
    }
}

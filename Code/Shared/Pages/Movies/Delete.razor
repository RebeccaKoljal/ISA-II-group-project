@page "/movies/delete"
@inject IMoviesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage 
    PageTitleText="Delete Movie" 
    EntityTitle="Movie" 
    Entity="item" 
    BasePath="/movies" 
    OnValidSubmit="delete" />

@code {
    private Movie item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
		item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete()
    {
		await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/movies");
    }
}

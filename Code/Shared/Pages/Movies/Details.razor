@page "/movies/details"
@inject IMoviesRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage
    PageTitleText="Details Movie"
    EntityTitle="Movie"
    Entity="item"
    EntityId="item?.Id"
    BasePath="/movies" />

@code {
    private Movie item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
		item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
}

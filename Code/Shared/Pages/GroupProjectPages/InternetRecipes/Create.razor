@page "/GroupProjectPages/internetRecipes/create"
@inject IInternetRecipesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage
    Entity="internetRecipe"
    EntityTitle="Internet Recipe"
    BasePath="/internetrecipes"
    OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(InternetRecipe))] private InternetRecipe internetRecipe { get; set; } = default!;
    protected override void OnInitialized() => internetRecipe ??= new();
    private async Task add()
    {
        await repo.CreateAsync(internetRecipe);
        NavigationManager.NavigateTo("/GroupProjectPages/internetRecipes");
    }
}

@page "/GroupProjectPages/Profile/Index"
@inject IUsersRepo UserRepo
@inject INotificationSettingsRepo SettingsRepo
@inject IProductsInUserInventoryRepo InventoryRepo
@inject NavigationManager Nav
@using Abc.Data.GroupProjectClasses.Nora
@using Abc.Data.GroupProjectClasses.Robi
@using Abc.Infra

<div class="profile-container">
    @if (isLoading)
    {
        <p class="state-text">Laadimine...</p>
    }
    else if (user == null)
    {
        <p class="state-text">Viga: Profiili andmeid ei leitud.</p>
    }
    else
    {
        <div class="user-green-card">
            <div class="card-left">
                <div class="user-avatar-circle">
                    <span class="avatar-icon">👤</span>
                </div>
                <div class="user-details">
                    <h2 class="user-name">@user.Name</h2>
                    <p class="user-email">@user.Email</p>
                </div>
            </div>

            <a href="/GroupProjectPages/Profile/Edit/@user.Id" class="btn-muuda-embed">Muuda</a>
        </div>

        <div class="overview-section">
            <h3 class="section-title">SAHVRI ÜLEVAADE</h3>
            <div class="expired-alert-card">
                <span class="alert-label">Aegunud toiduaineid sahvris:</span>
                <span class="alert-count">@expiredCount</span>
            </div>
        </div>

        <div class="settings-section">
            <h3 class="section-title">TEAVITUSSEADED</h3>

            <div class="setting-row">
                <span class="setting-label">E-posti teated</span>
                <input type="checkbox" class="setting-checkbox" checked="@settings?.IsEmailEnabled" disabled />
            </div>

            <div class="setting-row">
                <span class="setting-label">Push-teated</span>
                <input type="checkbox" class="setting-checkbox" checked="@settings?.IsPushEnabled" disabled />
            </div>

            <div class="setting-row">
                <span class="setting-label">Teavituse ettenägemisaeg</span>
                <span class="days-badge">@settings?.DaysBeforeExpiry päeva enne aegumist</span>
            </div>
        </div>

        <div class="profile-actions-bar">
            <a href="/GroupProjectPages/Profile/Delete/@user.Id" class="btn btn-delete">Kustuta profiil</a>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private User? user;
    private NotificationSettings? settings;
    private int expiredCount = 0;

    protected override async Task OnInitializedAsync()
    {
		var usersList = await UserRepo.GetAsync(new Query()); // asks for all users and we take the first one, if it exists and not waste resources on asking for count separately
        user = usersList.FirstOrDefault();

        if (user is null)
        {
            Nav.NavigateTo("/GroupProjectPages/Profile/Create");
            return;
        }

        var settingsList = await SettingsRepo.GetAsync(new Query()); // if the user has profile
        settings = settingsList.FirstOrDefault(x => x.UserId == user.Id);

        var inventoryItems = await InventoryRepo.GetAsync(new Query(new Dictionary<string, string> { ["PageSize"] = "1000" }));

        if (inventoryItems is not null) // counts the expired items 
        {
            expiredCount = inventoryItems.Count(x => x.ExpiryDate < DateTime.Today);
        }

        isLoading = false;
    }
}

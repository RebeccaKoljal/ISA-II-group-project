@page "/GroupProjectPages/main"
@inject NavigationManager NavigationManager

<div class="container">
    <h1 class="title">Milline toiduaine?</h1>
    <div class="select-grid">
        <div class="select-card" @onclick='() => GoToPage("Valmistoit")'>
            Valmistoit
        </div>

        <div class="select-card" @onclick='() => GoToPage("Koostisosa")'>
            Koostisosa
        </div>
    </div>
    <div class="bottom-left" @onclick="GoToRecipe">
        Retseptid
    </div>
    <div class="bottom-right" @onclick="GoToInventory">
        Olemasolevad tooted
    </div>
    <div class="top-right" @onclick="GoToUser">
        Kasutaja
    </div>
</div>

@code {
    private void GoToPage(string type) => NavigationManager.NavigateTo($"/main/{Uri.EscapeDataString(type)}");
    private void GoToRecipe() => NavigationManager.NavigateTo("/GroupProjectPages/Recipe");
    private void GoToInventory() => NavigationManager.NavigateTo("/GroupProjectPages/Inventory");
    private void GoToUser() => NavigationManager.NavigateTo("/GroupProjectPages/User");
}

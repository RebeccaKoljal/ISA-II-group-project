@page "/GroupProjectPages/userRecipes/delete"
@inject IUserRecipesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage
    PageTitleText="Delete Ingredient"
    EntityTitle="Ingredient"
    Entity="item"
    BasePath="/userrecipes"
    OnValidSubmit="delete" />

@code {
    private UserRecipe item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete()
    {
        await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/GroupProjectPages/userRecipes");
    }
}

@page "/recipes/delete"
@inject IRecipesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage
    PageTitleText="Delete Recipe"
    EntityTitle="Recipe"
    Entity="item"
    BasePath="/recipes"
    OnValidSubmit="delete" />

@code {
    private Recipe item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete()
    {
        await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/recipes");
    }
}

@page "/recipes/edit"
@inject IRecipesRepo repo
@inject NavigationManager NavigationManager

<MyEditPage
    PageTitleText="Edit Recipe"
    EntityTitle="@recipe.Name"
    Entity="recipe"
    BasePath="/recipes"
    EntityId="@Id"
    OnValidSubmit="update" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(Recipe))] private Recipe recipe { get; set; }
    protected override async Task OnInitializedAsync()
    {
        recipe ??= await repo.GetAsync(Id);
        if (recipe is null) NavigationManager.NotFound();
    }
    private async Task update()
    {
        await repo.UpdateAsync(recipe!);
        NavigationManager.NavigateTo("/recipes");
    }
}

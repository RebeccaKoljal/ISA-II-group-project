@page "/GroupProjectPages/Recipe/Create"
@inject IRecipesRepo repo
@inject NavigationManager Nav

<div class="recipe-form-page">
    <div class="form-header">
        <a href="/GroupProjectPages/Recipes">← Tagasi</a>
        <h1>Lisa retsept</h1>
    </div>

    <EditForm Model="recipe" OnValidSubmit="Add" FormName="RecipeCreate">
        <div class="form-group">
            <label>Retsepti nimi *</label>
            <InputText @bind-Value="recipe.Name" placeholder="nt. Pannkoogid" />
        </div>
        <div class="form-group">
            <label>Kirjeldus</label>
            <InputText @bind-Value="recipe.Details" placeholder="Lühike kirjeldus..." />
        </div>
        <button type="submit" class="btn-save">Salvesta</button>
    </EditForm>
    <BottomNav />
</div>

@code {
    [SupplyParameterFromForm(FormName = "RecipeCreate")]
    private Recipe recipe { get; set; } = default!;
    protected override void OnInitialized() => recipe ??= new();
    private async Task Add()
    {
        await repo.CreateAsync(recipe);
        Nav.NavigateTo("/GroupProjectPages/Recipes");
    }
}
@page "/scan/delete"
@inject IBarcodesRepo repo
@inject NavigationManager NavigationManager
<MyDeletePage
    PageTitleText="Delete Barcode"
    EntityTitle="Barcode"
    Entity="item"
    BasePath="/scan"
    OnValidSubmit="delete" />
@code {
    private Barcode item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete()
    {
        await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/scan");
    }
}
@page "/scan"

@inject NavigationManager Nav
@inject IBarcodesRepo barcodesRepo

<div class="scan-page">
    <h1>Skanni toode</h1>

    <div class="scan-frame">
        <div class="scan-line"></div>
        <p class="scan-hint">Paiguta vöötkood raami sisse</p>
    </div>

    <button class="manual-button" @onclick="GoToManual">+ Lisa käsitsi toode</button>
</div>

<section class="barcode-section">
    <header class="barcode-section-header">
        <h2 class="barcode-section-title">Skännitud koodid</h2>
        
    </header>
    @if (!recentScans.Any())
    {
        <p class="no-scans">Skännitud tooteid pole veel.</p>
    }
    else
    {
        <ul class="scans-list">
            @foreach (var scan in recentScans)
            {
                <li class="scan-item">
                    <span class="scan-name">@scan.Name</span>
                    <span class="scan-time">@scan.ScannedAt.ToString("dd.MM HH:mm")</span>
                </li>
            }
        </ul>
    }


</section>

@code 
{
    private IEnumerable<Barcode> recentScans = [];

    protected override async Task OnInitializedAsync()
    {
        recentScans = await barcodesRepo.GetAsync(new Query());
    }
    private void GoToManual()
    {
        Nav.NavigateTo("/GroupProjectPages/Inventory/create");
    }
}
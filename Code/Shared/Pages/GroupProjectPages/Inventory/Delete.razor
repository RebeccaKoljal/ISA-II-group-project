@page "/GroupProjectPages/Inventory/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject IProductsInUserInventoryRepo repo
@inject NavigationManager Nav
@using Abc.Data.GroupProjectClasses.Nora

<InventoryDeletePage BasePath="/GroupProjectPages/Inventory"
                     FormName="DeleteInventory"
                     Item="item"
                     IdField="@idField"
                     OnValidSubmit="DeleteItem" />

@code {
    [SupplyParameterFromForm(FormName = "DeleteInventory")] private ProductsInUserInventory item { get; set; }
    [SupplyParameterFromQuery] private Guid Id { get; set; }

    private string idField => $"{item?.GetType().Name}.Id";

    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);
        if (item is null) Nav.NotFound();
    }

    private async Task DeleteItem()
    {
        await repo.DeleteAsync(item!.Id);
        Nav.NavigateTo("/GroupProjectPages/Inventory");
    }
}
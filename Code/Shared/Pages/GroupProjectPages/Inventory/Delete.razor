@page "/GroupProjectPages/Inventory/delete"
@inject IProductsInUserInventoryRepo repo
@inject NavigationManager Nav
@using Abc.Data.GroupProjectClasses.Nora

@if (item == null)
{
    <p>Laadimine...</p>
}
else
{
    <div class="delete-page">
        <div class="delete-header">
            <a class="back-btn" href="/GroupProjectPages/Inventory">← Tagasi</a>
            <h1>Kustuta toode</h1>
        </div>

        <div class="delete-card">
            <p>Kas oled kindel, et soovid kustutada:</p>
            <h2>@item.ProductName</h2>
            <p class="delete-sub">@item.Quantity g · @(item.ExpiryDate?.ToString("dd.MM.yyyy") ?? "–")</p>
        </div>

        <div class="delete-actions">
            <a class="btn-cancel" href="/GroupProjectPages/Inventory">Tühista</a>
            <button class="btn-confirm-delete" @onclick="ConfirmDelete">🗑 Kustuta</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    private ProductsInUserInventory item;

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) Nav.NavigateTo("/GroupProjectPages/Inventory");
    }

    private async Task ConfirmDelete()
    {
        await repo.DeleteAsync(item.Id);
        Nav.NavigateTo("/GroupProjectPages/Inventory", forceLoad: true);
    }
}
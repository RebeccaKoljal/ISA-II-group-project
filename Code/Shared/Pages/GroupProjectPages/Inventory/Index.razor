@page "/GroupProjectPages/Inventory"
@inject IProductsInUserInventoryRepo repo
@using Abc.Data.GroupProjectClasses.Nora
@inject INotificationsRepo notifRepo
@using Abc.Data.GroupProjectClasses.Robi

<div class="inventory-page">
    <div class="inventory-header">
        <h1 class="page-title">Sinu sahver</h1>
        <a class="btn-add" href="@($"{BasePath}/create")">+ Lisa toode</a>
    </div>

    @if (items == null)
    {
        <p class="state-text">Laadimine...</p>
    }
    else if (!items.Any())
    {
        <p class="state-text">Sahver on tühi.</p>
    }
    else
    {
        <div class="stats">
            <div class="stat">
                <span class="stat-num">@items.Count()</span>
                <span class="stat-label">TOODET</span>
            </div>
            <div class="stat">
                <span class="stat-num warn">@items.Count(x => x.ExpiryDate.HasValue && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days is >= 0 and <= 3)</span>
                <span class="stat-label">AEGUMAS</span>
            </div>
            <div class="stat">
                <span class="stat-num danger">@items.Count(x => x.ExpiryDate.HasValue && x.ExpiryDate.Value.Date < DateTime.Now.Date)</span>
                <span class="stat-label">AEGUNUD</span>
            </div>
        </div>

        @if (items.Any(x => x.ExpiryDate.HasValue && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days <= 1 && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days >= 0))
        {
            var count = items.Count(x => x.ExpiryDate.HasValue && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days <= 1 && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days >= 0);
            <div class="warning-banner">
                ⚠ <b>@count toode(t) aegub(vad) homme</b> —
                <a href="/GroupProjectPages/Recipe">Vaata retsepte</a>
            </div>
        }

        <div class="filter-row">
            @foreach (var cat in categories)
            {
                <button class="filter-btn @(activeCategory == cat ? "active" : "")"
                        @onclick="() => activeCategory = cat">@cat</button>
            }
        </div>

        <div class="product-list">
            @foreach (var item in filteredItems)
            {
                <div class="product-card">
                    <div class="product-info">
                        <a class="product-name" href="/GroupProjectPages/Inventory/details?Id=@item.Id">@item.ProductName</a>
                        <span class="product-qty">@item.Quantity g</span>
                        <span class="product-expiry @GetExpiryClass(item.ExpiryDate)">
                            @GetExpiryText(item.ExpiryDate)
                        </span>
                    </div>
                    <div class="product-actions">
                        <a href="@($"{BasePath}/edit?Id={item.Id}")">Muuda</a>
                        <a class="btn-delete" href="@($"{BasePath}/delete?Id={item.Id}")">Kustuta</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private const string BasePath = "/GroupProjectPages/Inventory";
    private IEnumerable<ProductsInUserInventory> items;
    private string activeCategory = "Kõik";

    private List<string> categories = ["Kõik", "Piimatooted", "Liha", "Köögivili", "Puuviljad", "Joogid", "Leib", "Muu"];

    private IEnumerable<ProductsInUserInventory> filteredItems =>
        activeCategory == "Kõik"
            ? items
            : items.Where(x => x.Category == activeCategory);

    protected override async Task OnInitializedAsync()
    {
        items = (await repo.GetAsync(new Query(new Dictionary<string, string> { ["PageSize"] = "1000" })))
      .OrderBy(x => x.ExpiryDate ?? DateTime.MaxValue);

        await CreateExpiryNotifications();
    }

    private async Task CreateExpiryNotifications()
    {
        var existingNotifs = (await notifRepo.GetAsync(new Query())).ToList();

        foreach (var item in items.Where(x => x.ExpiryDate.HasValue))
        {
            var days = (item.ExpiryDate.Value.Date - DateTime.Now.Date).Days;
            if (days > 3 || days < 0) continue;

            var alreadyExists = existingNotifs.Any(n =>
                n.ProductId == item.Id &&
                n.ValidFrom.HasValue &&
                n.ValidFrom.Value.Date == DateTime.Now.Date);

            if (!alreadyExists)
            {
                var message = days == 0 ? $"{item.ProductName} aegub täna!"
                            : days == 1 ? $"{item.ProductName} aegub homme!"
                            : $"{item.ProductName} aegub {days} päeva pärast.";

                await notifRepo.CreateAsync(new Notifications
                {
                    Name = message,
                    ProductId = item.Id,
                    SentAt = DateTime.Now,
                    ValidFrom = DateTime.Now,
                    IsRead = false
                });
            }
        }
    }

    private static string GetExpiryClass(DateTime? date)
    {
        if (date == null) return "";
        var days = (date.Value - DateTime.Now).Days;
        return days < 0 ? "expired" : days <= 3 ? "soon" : "";
    }

    private static string GetExpiryText(DateTime? date)
    {
        if (date == null) return "-";
        var days = (date.Value - DateTime.Now).Days;
        return days < 0 ? "Aegunud" : $"Aegub {date.Value:dd.MM.yyyy}";
    }
}

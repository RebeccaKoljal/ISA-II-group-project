@page "/GroupProjectPages/Inventory"
@inject IProductsInUserInventoryRepo repo
@using Abc.Data.GroupProjectClasses.Nora

<div class="inventory-page">
    <div class="inventory-header">
        <h1 class="page-title">Sinu sahver</h1>
        <a class="btn-add" href="@($"{BasePath}/create")">+ Lisa toode</a>
    </div>

    @if (items == null)
    {
        <p class="state-text">Laadimine...</p>
    }
    else if (!items.Any())
    {
        <p class="state-text">Sahver on tühi.</p>
    }
    else
    {
        <div class="stats">
            <div class="stat">
                <span class="stat-num">@items.Count()</span>
                <span class="stat-label">TOODET</span>
            </div>
            <div class="stat">
                <span class="stat-num warn">@items.Count(x => x.ExpiryDate.HasValue && (x.ExpiryDate.Value.Date - DateTime.Now.Date).Days is >= 0 and <= 3)</span>
                <span class="stat-label">AEGUMAS</span>
            </div>
            <div class="stat">
                <span class="stat-num danger">@items.Count(x => x.ExpiryDate.HasValue && x.ExpiryDate.Value.Date < DateTime.Now.Date)</span>
                <span class="stat-label">AEGUNUD</span>
            </div>
        </div>

        <div class="product-list">
            @foreach (var item in items)
            {
                <div class="product-card">
                    <div class="product-info">
                        <span class="product-name">@item.ProductName</span>
                        <span class="product-qty">@item.Quantity g</span>
                        <span class="product-expiry @GetExpiryClass(item.ExpiryDate)">
                            @GetExpiryText(item.ExpiryDate)
                        </span>
                    </div>
                    <div class="product-actions">
                        <a href="@($"{BasePath}/edit?Id={item.Id}")">Muuda</a>
                        <a class="btn-delete" href="@($"{BasePath}/delete?Id={item.Id}")">Kustuta</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private const string BasePath = "/GroupProjectPages/Inventory";
    private IEnumerable<ProductsInUserInventory>? items;

    protected override async Task OnInitializedAsync()
        => items = await repo.GetAsync(new Query());

    private static string GetExpiryClass(DateTime? date)
    {
        if (date == null) return "";
        var days = (date.Value - DateTime.Now).Days;
        return days < 0 ? "expired" : days <= 3 ? "soon" : "";
    }

    private static string GetExpiryText(DateTime? date)
    {
        if (date == null) return "-";
        var days = (date.Value - DateTime.Now).Days;
        return days < 0 ? "Aegunud" : $"Aegub {date.Value:dd.MM.yyyy}";
    }
}
@page "/GroupProjectPages/Inventory/edit"
@inject IProductsInUserInventoryRepo repo
@inject NavigationManager Nav
@using Abc.Data.GroupProjectClasses.Nora

<InventoryFormPage Title="Muuda toodet"
                   BasePath="/GroupProjectPages/Inventory"
                   FormName="InventoryEdit"
                   Item="item"
                   HiddenId="@Id"
                   IdField="@idField"
                   OnValidSubmit="Update" />

@code {
    private const string BasePath = "/GroupProjectPages/Inventory";
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(FormName = "InventoryEdit")] private ProductsInUserInventory item { get; set; }

    private string idField => $"{item?.GetType().Name}.Id";

    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);
        if (item is null) Nav.NotFound();
    }

    private async Task Update()
    {
        var existing = await repo.GetAsync(Id);
        existing.ProductName = item.ProductName;
        existing.Quantity = item.Quantity;
        existing.ExpiryDate = item.ExpiryDate;
        await repo.UpdateAsync(existing);
        Nav.NavigateTo(BasePath);
    }
}
}
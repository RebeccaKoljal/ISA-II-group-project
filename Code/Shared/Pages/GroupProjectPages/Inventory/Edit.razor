@page "/GroupProjectPages/Inventory/edit"
@attribute [ExcludeFromInteractiveRouting]
@inject IProductsInUserInventoryRepo repo
@inject NavigationManager NavigationManager
@using Abc.Data.GroupProjectClasses.Nora
@using Abc.Infra

<h1 class="title text-center">Muuda toodet</h1>

@if (item != null)
{
    <EditForm Model="item" OnValidSubmit="update" FormName="InventoryEdit">
        <div>
            <label>Kogus (g)</label>
            <InputNumber @bind-Value="item.Quantity" min="0" />
        </div>
        <div>
            <label>Aegumiskuupäev</label>
            <InputDate @bind-Value="item.ExpiryDate" />
        </div>
        <button type="submit">Salvesta</button>
        <a href="/inventory">Tagasi</a>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(FormName = "InventoryEdit")] private ProductsInUserInventory item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }

    private async Task update()
    {
        await repo.UpdateAsync(item!);
        NavigationManager.NavigateTo("/GroupProjectPages/Inventory");
    }
}
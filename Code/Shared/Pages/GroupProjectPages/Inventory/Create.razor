@page "/GroupProjectPages/Inventory/create"
@inject IProductsInUserInventoryRepo repo
@inject NavigationManager Nav
@using Abc.Data.GroupProjectClasses.Nora

<InventoryFormPage Title="Lisa toode"
                   BasePath="/GroupProjectPages/Inventory"
                   FormName="InventoryCreate"
                   Item="item"
                   OnValidSubmit="Add" />

@code {
    [SupplyParameterFromForm(FormName = "InventoryCreate")]
    private ProductsInUserInventory item { get; set; } = default!;

    protected override void OnInitialized() => item ??= new();

    private async Task Add()
    {
        await repo.CreateAsync(item);
        Nav.NavigateTo("/GroupProjectPages/Inventory");
    }
}
@using Microsoft.AspNetCore.Components
@using System.Reflection

<div class="mb-3">
	@if (hasProperty)
	{
		<label for="@PropertyName" class="form-label">@inputLabel</label>
		@if (hasEditor)
		{
			<DynamicComponent Type="@editorType" Parameters="@editorParams" />
			<DynamicComponent Type="@validationType" Parameters="@validationParams" />
		}
	}
</div>

@code {
	[Parameter] public object Item { get; set; }
	[Parameter] public string PropertyName { get; set; } = string.Empty;
	protected override void OnParametersSet() => ad = crAdapter();
	private IEditorAdapter crAdapter() => new EditorAdapter(this, Item, PropertyName);
	private IEditorAdapter ad;
	private bool hasEditor => editorType is not null;
	private bool hasProperty => ad?.PropInfo is not null;
	private string inputLabel => ad?.DisplayName ?? string.Empty;
	private Type editorType => ad?.Editor;
	private Type validationType => ad?.Validator;
	private IDictionary<string, object> editorParams => ad?.EditorParams;
	private IDictionary<string, object> validationParams => ad?.ValidationParams;
}


@* @typeparam TValue

<div class="mb-3">
	<label for="@Id" class="form-label">@Label</label>
	@if (IsString)
	{
		<InputText id="@Id" class="form-control" Value="@StringValue"
			ValueChanged="@OnStringValueChanged" ValueExpression="@StringValueExpression" />
	}
	else if (IsDate)
	{
		<InputDate TValue="TValue" id="@Id" class="form-control" Value="@Value"
			ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
	}
	else if (IsBool)
	{
		<InputCheckbox TValue="TValue" id="@Id" class="form-control" Value="@BoolValue"
				   ValueChanged="@OnBoolValueChanged" ValueExpression="@BoolValueExpression" />
	}
	else
	{
		<InputNumber TValue="TValue" id="@Id" class="form-control" Value="@Value"
			ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
	}
	<ValidationMessage For="@ValueExpression" class="text-danger" />
</div>

@code {
	[Parameter] public string Id { get; set; } = string.Empty;
	[Parameter]	public string Label { get; set; } = string.Empty;
	[Parameter] public TValue Value { get; set; } 
	[Parameter] public EventCallback<TValue> ValueChanged { get; set; }
	[Parameter] public Expression<Func<TValue>> ValueExpression { get; set; }
	private static Type UnderlyingType => Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
	private static bool IsString => UnderlyingType == typeof(string);
	private static bool IsBool => UnderlyingType == typeof(bool);
	private static bool IsDate => UnderlyingType == typeof(DateTime) || UnderlyingType == typeof(DateOnly);
	private string StringValue => Value as string;
	private bool BoolValue => Convert.ToBoolean(Value);
	private Task OnStringValueChanged(string value)
	{
		return ValueChanged.InvokeAsync((TValue)(object)value);
	}
	private Task OnBoolValueChanged(bool value)
	{
		return ValueChanged.InvokeAsync((TValue)(object)value);
	}
	private Expression<Func<string>> StringValueExpression => ValueExpression as Expression<Func<string>>;
	private Expression<Func<bool>> BoolValueExpression => ValueExpression as Expression<Func<bool>>;
} *@
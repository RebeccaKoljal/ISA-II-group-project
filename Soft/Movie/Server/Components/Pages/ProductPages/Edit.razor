@page "/products/edit"
@attribute [ExcludeFromInteractiveRouting]
@inject IProductsRepo repo
@inject NavigationManager NavigationManager

<MyEditPage 
    PageTitleText="Edit Product" 
    EntityTitle="Product" 
    Entity="product" 
    BasePath="/products" 
    EntityId="@Id"
    OnValidSubmit="update" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm] private Product product { get; set; }
    protected override async Task OnInitializedAsync()
    {
		product ??= await repo.GetAsync(Id);
        if (product is null) NavigationManager.NotFound();
    }
    private async Task update()
    {
		await repo.UpdateAsync(product!);
        NavigationManager.NavigateTo("/products");
    }
}

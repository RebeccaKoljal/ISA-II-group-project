@page "/currencies/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Abc.Data
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<PageTitle>Create Currency</PageTitle>

<h1>Create</h1>

<h2>Currency</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="currency" OnValidSubmit="addCurrency" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <MyPropertyEditor TValue="string" Id="numericCode" Label="Numeric Code:" @bind-Value="@currency.NumericCode" />
            <MyPropertyEditor TValue="string" Id="majorUnitSymbol" Label="Major Unit Symbol:" @bind-Value="@currency.MajorUnitSymbol" />
            <MyPropertyEditor TValue="string" Id="minorUnitSymbol" Label="Minor Unit Symbol:" @bind-Value="@currency.MinorUnitSymbol" />
            <MyPropertyEditor TValue="string" Id="ratioOfMinorUnit" Label="Ratio Of Minor Unit:" @bind-Value="@currency.RatioOfMinorUnit" />
            <MyPropertyEditor TValue="bool" Id="isIsoCurrency" Label="Is ISO Currency:" @bind-Value="@currency.IsIsoCurrency" />
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/currencies">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm] private Currency currency { get; set; } = default!;

    protected override void OnInitialized() => currency ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task addCurrency()
    {
		await repo.CreateAsync(currency);
        NavigationManager.NavigateTo("/currencies");
    }
}

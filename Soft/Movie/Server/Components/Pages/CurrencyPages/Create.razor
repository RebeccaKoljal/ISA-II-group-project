@page "/currencies/create"
@attribute [ExcludeFromInteractiveRouting]
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage EntityTitle="Currency" Entity="currency" BasePath="/currencies" OnValidSubmit="addCurrency" />

@code {
    [SupplyParameterFromForm] private Currency currency { get; set; } = default!;
    protected override void OnInitialized() => currency ??= new();
    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task addCurrency()
    {
		await repo.CreateAsync(currency);
        NavigationManager.NavigateTo("/currencies");
    }
}

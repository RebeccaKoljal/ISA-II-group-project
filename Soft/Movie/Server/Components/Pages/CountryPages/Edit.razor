@page "/countries/edit"
@attribute [ExcludeFromInteractiveRouting]
@inject ICountriesRepo repo
@inject NavigationManager NavigationManager

<MyEditPage 
    PageTitleText="Edit Country" 
    EntityTitle="@country.Name" 
    Entity="country" 
    BasePath="/countries" 
    EntityId="@Id"
    OnValidSubmit="updateCountry" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm] private Country country { get; set; }
    protected override async Task OnInitializedAsync()
    {
        country ??= await repo.GetAsync(Id);
		if (country is null) NavigationManager.NotFound();
    }
    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task updateCountry()
    {
		await repo.UpdateAsync(country);
        NavigationManager.NavigateTo("/countries");
    }
}

@page "/countries/details"
@attribute [ExcludeFromInteractiveRouting]
@inject ICountriesRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage 
    PageTitleText="Details Country"
    EntityTitle="Country"
    Entity="item"
    EntityId="item?.Id"
    BasePath="/countries" />

@code {
    private Country item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
		item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
}

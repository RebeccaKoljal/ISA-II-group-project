@page "/movies/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Abc.Data
@inject IMoviesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage PageTitleText="Create Movie" EntityTitle="Movie" Entity="Movie" BasePath="/movies" OnValidSubmit="AddMovie" />


@code {
    [SupplyParameterFromForm] private Movie Movie { get; set; } = default!;

    protected override void OnInitialized() => Movie ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddMovie()
    {
		await repo.CreateAsync(Movie);
        NavigationManager.NavigateTo("/movies");
    }
}

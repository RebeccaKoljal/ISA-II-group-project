@page "/money/create"
@attribute [ExcludeFromInteractiveRouting]
@inject IMoniesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage 
    Entity="money"
    EntityTitle="Money" 
    BasePath="/money" 
    OnValidSubmit="add" />


@code {
    [SupplyParameterFromForm(Name = nameof(Money))] private Money money { get; set; } = default!;
    protected override void OnInitialized() => money ??= new();
    private async Task add()
    {
		await repo.CreateAsync(money);
        NavigationManager.NavigateTo("/money");
    }
}

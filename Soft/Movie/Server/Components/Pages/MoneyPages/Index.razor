@page "/monies"
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager NavigationManager
@inject IMoniesRepo repo

<MyIndexPage 
    TItem="Money"
    PageTitleText="Monies Page"
    EntityTitle="Money"
    Items="items"
    BasePath="/monies" />

@code {
    private IQueryable<Money> items = Enumerable.Empty<Money>().AsQueryable();
    protected override async Task OnInitializedAsync()
    {
        if (repo is null) return;
        items = (await repo.GetAsync()).AsQueryable();
    }
}
